# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GOLDFRONT_OWNER=lindsey

# Railway Docker ARGs (same names as service Variables — required for HUD clone).
# Dockerfile declares ARG HUD_BUILD and uses it in the git clone RUN so a bump
# busts cache. Railway maps matching env vars as build args.
# CONRAD_COMMAND_CENTER_REF=cursor/jarvis-iron-man-hud-2fef
# HUD_BUILD=2026-09-13-phase1-jenman
CONRAD_COMMAND_CENTER_REF=main
HUD_BUILD=dev

# ClickUp API v2 — https://app.clickup.com/settings/apps
CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=90141259054
CLICKUP_AUTO_SYNC=true

# Fieldy — user-provided token; copy from Mac goldfront-os/.env to Manus .env
FIELDY_API_TOKEN=
FIELDY_API_BASE=https://api.fieldy.ai
FIELDY_SPEAKER_ME=Lindsey

# Google OAuth (Calendar + Gmail) — one refresh token with both scopes
# After CLIENT_ID + SECRET: visit http://127.0.0.1:8000/connect/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/google/oauth/callback

# GoHighLevel — Settings → API Keys (Brain / JARVIS Command Center client)
# Team CRM (The Conrad Team) — use this for Brain reads/writes via API:
GHL_API_KEY=
GHL_LOCATION_ID=FFdZCVGXSQQThtHZEOYx
# Personal apply capture (rhinolending.capital/apply) — NOT Brain's write target:
# GHL_PERSONAL_APPLY_LOCATION_ID=3nUeqiIgQEtLuQJUbWVO
# See docs/jarvis-command-center.md — never confuse personal apply with Team FFdZ.

# Whoop OAuth — https://developer.whoop.com (see deploy/WHOOP-SETUP.md)
# Persistent: client id + secret + refresh token (python3 scripts/whoop_oauth_setup.py)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=
# Legacy static token — expires ~1h; prefer OAuth trio above
WHOOP_ACCESS_TOKEN=

# Meta Ads — Marketing API read (spend, leads, CPL)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Apple Health — path to a JSON export your sync writes (display only)
APPLE_HEALTH_EXPORT_PATH=

# Legacy MCP (optional)
CLICKUP_MCP_URL=https://mcp.clickup.com/mcp
DECISION_HALFLIFE_DAYS=180
